{
  "name": "uml-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PWA colaborativa de modelado UML 2.5 con generacion de backend Spring Boot",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "seed": "pnpm --filter @uml-forge/api seed",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
