# Copia este fichero a .env y ajusta los valores.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=umlforge
POSTGRES_PASSWORD=umlforge
POSTGRES_DB=umlforge
POSTGRES_PORT=5432

# --- Base de datos Prisma (apps/api) ---
DATABASE_URL=postgresql://umlforge:umlforge@localhost:5432/umlforge?schema=public

# --- Puertos publicados por Docker Compose ---
API_PORT=3000
WEB_PORT=8080
# Siembra los datos de demostracion al arrancar la API, solo si la base de datos esta vacia.
SEED_ON_START=true
# Ollama vive en la maquina anfitriona, no en la red de contenedores.
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# --- Servidor API (apps/api) ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Seguridad y Autenticacion JWT (apps/api) ---
JWT_ACCESS_SECRET=umlforge_dev_jwt_access_secret_key_32bytes_min_super_secure!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=umlforge_dev_jwt_refresh_secret_key_32bytes_min_super_secure!
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=umlforge_dev_cookie_secret_key_32bytes_min_super_secure!

# --- Limitador de Tasa (Rate Limiting) ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Proveedor de IA en Servidor ---
# Proveedor activo: 'gemini' (nube, por defecto) u 'ollama' (local, sin internet).
# El otro actua como respaldo automatico si el activo falla.
AI_PROVIDER=gemini
# Cookies para la pila local HTTP; usar true al desplegar con HTTPS.
COOKIE_SECURE=false
# Clave de la Gemini Developer API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Si el modelo principal esta saturado (5xx) o sin cuota (429) se reintenta con este. Vacio lo desactiva.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Gemini por Vertex AI en lugar de clave: usa las credenciales de Google Cloud
# (cuenta de servicio en Cloud Run, o `gcloud auth application-default login`).
GEMINI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- Chat del equipo con IA ---
# Reparto de mensajes en tiempo real: 'memory' (una instancia de la API) o
# 'postgres' (LISTEN/NOTIFY: varias instancias comparten el chat).
CHAT_EVENT_BUS=memory

# --- Respaldo local de IA (Ollama) ---
# Modelo de texto: ligero y fiable generando JSON. Alternativa: llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Modelo multimodal para leer la foto de un diagrama. Mas ligero: moondream
OLLAMA_VISION_MODEL=llava:7b

# --- PWA (apps/web), solo si el canal de colaboracion no vive en el mismo origen ---
# VITE_COLLAB_URL=wss://mi-servidor/collab
