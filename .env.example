# Copia este fichero a .env y ajusta los valores.
# Fase 0: solo la base de datos de desarrollo.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=umlforge
POSTGRES_PASSWORD=umlforge
POSTGRES_DB=umlforge
POSTGRES_PORT=5432

# --- Cadena de conexion que consumira Prisma en la Fase 2 ---
DATABASE_URL=postgresql://umlforge:umlforge@localhost:5432/umlforge?schema=public
