datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

/// Quien escribe un mensaje del chat del proyecto.
enum ChatAuthorKind {
  USER
  ASSISTANT
}

/// Estado de una propuesta de cambios hecha por la IA en el chat.
enum ChatProposalStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum GenerationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens  RefreshToken[]
  ownedProjects  Project[]       @relation("ProjectOwner")
  memberships    ProjectMember[]
  operationLogs  OperationLog[]
  snapshots      ModelSnapshot[]
  generationJobs GenerationJob[]
  chatMessages   ChatMessage[]   @relation("ChatAuthor")
  chatResolved   ChatMessage[]   @relation("ChatProposalResolver")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members        ProjectMember[]
  ydocState      YDocState?
  snapshots      ModelSnapshot[]
  operationLogs  OperationLog[]
  generationJobs GenerationJob[]
  chatMessages   ChatMessage[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model YDocState {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state     Bytes
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ydoc_states")
}

model ModelSnapshot {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  description String?
  state       Bytes
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@map("model_snapshots")
}

model OperationLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  batchId   String?
  clientId  String?
  status    String   @default("applied")
  operation Json
  appliedAt DateTime @default(now())

  @@index([projectId])
  @@index([batchId])
  @@map("operation_logs")
}

model GenerationJob {
  id              String              @id @default(uuid())
  projectId       String
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  status          GenerationJobStatus @default(PENDING)
  targetFramework String              @default("SPRING_BOOT_3")
  resultUrl       String?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([projectId])
  @@map("generation_jobs")
}

/// Mensaje del chat de grupo de un proyecto (ADR 0042). Lo escribe una persona
/// o la IA; las respuestas de la IA pueden llevar una propuesta de cambios del
/// modelo que un editor aplica o descarta.
model ChatMessage {
  id                   String              @id @default(uuid())
  projectId            String
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind                 ChatAuthorKind
  authorId             String?
  author               User?               @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  content              String
  mentionsAi           Boolean             @default(false)
  isError              Boolean             @default(false)
  replyToId            String?
  replyTo              ChatMessage?        @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies              ChatMessage[]       @relation("ChatReply")
  /// Operaciones del lenguaje de uml-core, ya normalizadas, y su resumen.
  proposal             Json?
  proposalStatus       ChatProposalStatus?
  proposalResolvedById String?
  proposalResolvedBy   User?               @relation("ChatProposalResolver", fields: [proposalResolvedById], references: [id], onDelete: SetNull)
  proposalResolvedAt   DateTime?
  createdAt            DateTime            @default(now())

  @@index([projectId, createdAt])
  @@map("chat_messages")
}
