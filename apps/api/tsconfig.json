{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@uml-forge/tsconfig/nest.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "prisma.config.ts",
    "prisma/**/*.ts",
    "vitest.config.mts",
    "vitest.e2e.config.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
